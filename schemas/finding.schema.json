{
  "$defs": {
    "JsonValue": {}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "behaviour": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Behaviour"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "destination": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Destination"
    },
    "evidence": {
      "items": {
        "pattern": "^(timeline#[0-9]+|[^/\\\\:#.][^/\\\\:#]*(/[^/\\\\:#.][^/\\\\:#]*)*)$",
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "target": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Target",
      "type": "object"
    },
    "type": {
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "severity",
    "target",
    "destination",
    "behaviour",
    "first_seen",
    "evidence",
    "source",
    "confidence"
  ],
  "title": "Finding",
  "type": "object"
}
